# Private Postgres cluster for the tracker, run as your user (no root needed).
# One-time setup: see "Run locally as a service" in README.md.
[Unit]
Description=Postgres for IRCC Tracker

[Service]
ExecStart=/usr/lib/postgresql/18/bin/postgres -D %h/.local/share/ircc-tracker/pg -p 5433 -k %h/.local/share/ircc-tracker/pg -c listen_addresses=127.0.0.1
Restart=on-failure

[Install]
WantedBy=default.target
