# IRCC Tracker configuration. Copy to .env and fill in your own values:
#   cp .env.example .env && chmod 600 .env
# Never commit .env; it holds your GCKey password and authenticator secret.

# ---------------------------------------------------------------- Server
PORT=3460
# 127.0.0.1 keeps the API on this machine only. Use 0.0.0.0 inside Docker.
HOST=127.0.0.1
# Docker: only POSTGRES_PASSWORD is needed (letters and digits only, e.g. openssl rand -hex 24);
# docker-compose.yml builds DATABASE_URL from it and ignores the DATABASE_URL below.
POSTGRES_PASSWORD=
# Without Docker: your Postgres connection string. See "Run it in the background" in README.md.
DATABASE_URL=postgres://ircc:change-me@127.0.0.1:5433/ircc
DATABASE_SSL=false
# Key(s) for the HTTP API, comma-separated, each 16+ chars. Generate one with: openssl rand -hex 32
API_KEYS=

# ---------------------------------------------------------------- GCKey sign-in
GCKEY_USERNAME=
GCKEY_PASSWORD=
# Your GCKey authenticator-app secret. Paste either the base32 secret or the whole
# otpauth://totp/... link from the QR code you scanned when turning on two-factor.
GCKEY_TOTP_SECRET=

# ---------------------------------------------------------------- Your application
# Exactly as you would type them into the IRCC application status tracker form.
IRCC_SURNAME=
IRCC_GIVEN_NAME=
# Unique client identifier, digits only (no dashes)
IRCC_UCI=
# e.g. E001234567, W301234567, B000123456
IRCC_APPLICATION_NUMBER=
# YYYY-MM-DD
IRCC_DATE_OF_BIRTH=
# As spelled in the tracker's country list, e.g. India, China, Philippines, Nigeria
IRCC_COUNTRY_OF_BIRTH=

# ---------------------------------------------------------------- Schedule
# Cron expression; the default runs every 2 hours at minute 17.
# The lookup form allows 3 attempts per 15 minutes, so don't go below every 15 minutes.
CHECK_CRON=17 */2 * * *
# IANA time zone for CHECK_CRON. Defaults to this machine's time zone.
CHECK_TIMEZONE=
# Run one check right after start-up.
CHECK_ON_BOOT=true

# ---------------------------------------------------------------- Browser
# GCKey's hCaptcha rejects headless Chrome. Keep this false and run under Xvfb
# (the systemd unit and Docker image do that for you) so no window appears.
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chrome
# Keeps hCaptcha cookies between runs. A screenshot is saved here as last-failure.png when a step fails.
BROWSER_PROFILE_DIR=./.browser-profile
# Canada.ca blocks datacenter IPs (AWS, GCP, Azure...). On a cloud server, route Chrome through
# a residential proxy: http://user:pass@host:port or socks5://host:port. Leave empty at home.
BROWSER_PROXY_URL=

# ---------------------------------------------------------------- Email alerts (optional)
# Sent through a useSend instance (https://usesend.com, open source, self-hostable).
# Leave USESEND_API_KEY empty to turn email off.
USESEND_API_URL=
USESEND_API_KEY=
# Comma-separated recipients
NOTIFY_EMAIL_TO=
# A sender on a domain verified in useSend, e.g. IRCC Tracker <noreply@example.com>
NOTIFY_EMAIL_FROM=
# true: email after every check ("No update" includes the latest raw responses).
# false: email only when something changes.
NOTIFY_EVERY_CHECK=true
# Email once after this many failed checks in a row.
NOTIFY_ERROR_AFTER=2
