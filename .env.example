PORT=3000
DATABASE_URL=postgres://ircc:ircc@localhost:5432/ircc
DATABASE_SSL=false
# Comma-separated, each at least 16 chars. Generate with: openssl rand -hex 32
API_KEYS=change-me-to-a-long-random-key

# GCKey sign-in
GCKEY_USERNAME=
GCKEY_PASSWORD=

# The GCKey two-factor code is read from Authkeep (github.com/HermanL02/authkeep)
AUTHKEEP_API_URL=https://api.authkeep.example.com
AUTHKEEP_API_KEY=
AUTHKEEP_TOTP_LABEL=GCKey (XXXX)

# Application lookup form
IRCC_SURNAME=
IRCC_GIVEN_NAME=
IRCC_UCI=
IRCC_APPLICATION_NUMBER=
IRCC_DATE_OF_BIRTH=YYYY-MM-DD
IRCC_COUNTRY_OF_BIRTH=

# hCaptcha rejects headless Chrome; the Docker image runs headed Chrome under Xvfb.
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chrome

# Cron in CHECK_TIMEZONE. The lookup form allows 3 attempts per 15 minutes, so don't go below that.
CHECK_CRON=17 */6 * * *
CHECK_TIMEZONE=America/Halifax
CHECK_ON_BOOT=true

# Optional email alerts via useSend. Leave USESEND_API_KEY empty to disable.
USESEND_API_URL=https://mail.example.com
USESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=IRCC Tracker <ircc@example.com>
NOTIFY_ERROR_AFTER=2

# Persistent Chrome profile (hCaptcha cookies) and last-failure.png
BROWSER_PROFILE_DIR=./.browser-profile
