{
  "name": "ircc-tracker",
  "version": "1.0.0",
  "description": "Automatic IRCC application status tracker: signs in with GCKey (2FA), checks your Canada immigration application on a schedule and emails you every change.",
  "author": "Herman Liang",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "pg": "^8.23.1",
    "playwright": "^1.57.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ircc",
    "ircc-tracker",
    "application-status",
    "gckey",
    "canada",
    "immigration",
    "express-entry",
    "pnp",
    "permanent-residence",
    "citizenship",
    "work-permit",
    "study-permit",
    "email-alerts",
    "nestjs",
    "playwright",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HermanL02/ircc-tracker.git"
  },
  "homepage": "https://github.com/HermanL02/ircc-tracker#readme",
  "bugs": {
    "url": "https://github.com/HermanL02/ircc-tracker/issues"
  }
}
